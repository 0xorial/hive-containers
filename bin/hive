#!/usr/bin/env bash
# hive — hierarchical Claude Code containers on a shared Docker engine.
set -euo pipefail

PREFIX=hive-
NET=hive-net
NODE_IMAGE=${HIVE_NODE_IMAGE:-hive/node}
DEV_IMAGE=${HIVE_DEV_IMAGE:-hive/dev}
HOSTD_TOKEN_FILE="$HOME/.config/hive/hostd-token"
HOSTD_MAC_PORT=${HIVE_HOSTD_MAC_PORT:-8799}       # Mac daemon port; nodes reach it at host.docker.internal:<port>

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HIVE_SELF="$script_dir/$(basename "${BASH_SOURCE[0]}")"
HIVE_HOME="${HIVE_HOME:-$(dirname "$script_dir")}"
# Inside the root container the CLI is bind-mounted at /usr/local/bin/hive but
# the repo lives at /workspace — so hive runs as the in-container control plane.
if [ ! -f "$HIVE_HOME/compose.yaml" ] && [ -f /workspace/compose.yaml ]; then
  HIVE_HOME=/workspace
fi

# Pin hive to one engine regardless of the active docker context (e.g. colima
# grabbing the default when it starts). Precedence: HIVE_DOCKER_CONTEXT env,
# then config/docker-context, then whatever context is active.
if [ -n "${HIVE_DOCKER_CONTEXT:-}" ]; then
  export DOCKER_CONTEXT="$HIVE_DOCKER_CONTEXT"
elif [ -f "$HIVE_HOME/config/docker-context" ]; then
  _ctx="$(head -1 "$HIVE_HOME/config/docker-context")"
  # ignore the pin where that context doesn't exist (e.g. inside the root container)
  if docker context inspect "$_ctx" >/dev/null 2>&1; then
    export DOCKER_CONTEXT="$_ctx"
  fi
fi

# OCI runtime for nodes. Empty = the engine default (runc). Set to e.g. "kata"
# (once registered in the engine) for VM-isolated nodes. config/runtime or env.
NODE_RUNTIME="${HIVE_RUNTIME:-}"
if [ -z "$NODE_RUNTIME" ] && [ -f "$HIVE_HOME/config/runtime" ]; then
  NODE_RUNTIME="$(head -1 "$HIVE_HOME/config/runtime" | tr -d '[:space:]')"
fi

die()  { echo "hive: $*" >&2; exit 1; }
note() { echo "hive: $*" >&2; }

compose() {
  if [ ! -f "$HIVE_HOME/compose.yaml" ]; then
    die "compose.yaml not found under HIVE_HOME=$HIVE_HOME — run this from your hive checkout (inside the root container use /workspace/bin/hive)"
  fi
  docker compose -f "$HIVE_HOME/compose.yaml" "$@"
}

tty_flags() {
  if [ -t 0 ] && [ -t 1 ]; then echo "-it"; else echo "-i"; fi
}

usage() {
  cat <<'EOF'
hive — hierarchical Claude Code containers on a shared Docker engine

lifecycle
  hive build                       build/rebuild all images
  hive up                          start root (builds if needed)
  hive down                        stop nodes, take down root
  hive status                      what's running
  hive doctor                      verify the engine + control plane

nodes
  hive new <name> [opts] [-- docker-run-args]
       --parent <node>             logical parent (default: root)
       --bind <abs-path>           bind-mount a Mac dir as /workspace
                                   (default: named volume hive-ws-<name>)
       --image <img>               alternate image (default: hive/node)
       --dind                      nested docker engine (privileged; uses hive/dev)
       --docker                    mount the host Docker socket (use the host engine; uses hive/dev)
  hive ls                          list containers + guests on hive-net
  hive tree                        show the hierarchy
  hive sh [name] [cmd...]          shell into a node (default: root)
  hive claude <name> [args...]     run claude in a node (e.g. -p "fix tests")
  hive rm <name>... [--purge]      remove node(s); --purge drops claude+dind volumes (workspace volume is always kept)
  hive join <container>            attach an existing container to the hive network

per-node switches (live — applied to the running container, no recreate)
  hive <node> github on|off|status     give/remove your github token for one node
  hive <node> host on|off|status       let this node run commands on your Mac
  hive <node> dind on|off|status       nested docker engine (recreates the node)
  hive <node> docker on|off|status     mount the host Docker socket instead (recreates; turns dind off)
  hive <node> status                   show github + host + dind + docker state
  hive <node> sh|claude [...]          same as 'hive sh <node>' / 'hive claude <node>'

run commands on the Mac from a node (deliberate, opt-in hole)
  hive hostd start|stop|status|logs    the Mac-side daemon
  hive <node> host on                  then, inside the node:  host <command>
  hive new <name> --host               sugar for: new + host on

desktop app / direct ssh
  hive ssh setup                   one-time: key + ~/.ssh/config + install into nodes
                                   (then: desktop app -> add SSH connection 'hive-<node>')
  hive ssh <node>                  plain ssh into a node (rides docker exec, no open port)

private github (no token pasting — hive logs you in once)
  hive <node> github on            logs you in via browser the first time, caches
                                   the token hive-wide, installs it in <node>
  hive <node> github off           remove the token from <node>
  hive github login                (re)run the GitHub login and cache the token
  hive github --forget             delete the cached token

devcontainers
  hive devcontainer <project-dir>  drop a .devcontainer that joins the hive
EOF
}

# ---------------- lifecycle ----------------

cmd_build() {
  docker build -f "$HIVE_HOME/images/node/Dockerfile" -t hive/node "$HIVE_HOME"
  # refresh the dind dev image only if it's already been built
  if docker image inspect "$DEV_IMAGE" >/dev/null 2>&1; then
    docker build -f "$HIVE_HOME/images/dev/Dockerfile" -t "$DEV_IMAGE" "$HIVE_HOME"
  fi
  compose build
}

cmd_up() {
  if ! docker image inspect "$NODE_IMAGE" >/dev/null 2>&1; then
    note "first run: building images (this takes a few minutes)"
    cmd_build
  fi
  # Legacy migration: an older hive created hive-net as `internal` (no internet).
  # Compose won't flip an existing network's flags, so recreate it here:
  # disconnect attached containers, drop it, let compose remake it non-internal,
  # then reconnect the nodes (root is reconnected by compose).
  local reconnect="" _n
  if docker network inspect "$NET" >/dev/null 2>&1 \
     && [ "$(docker network inspect "$NET" -f '{{.Internal}}' 2>/dev/null)" = true ]; then
    note "$NET is a legacy 'internal' network (no internet) — recreating it…"
    reconnect=$(docker network inspect "$NET" -f '{{range .Containers}}{{.Name}} {{end}}' 2>/dev/null)
    # shellcheck disable=SC2086
    for _n in $reconnect; do docker network disconnect -f "$NET" "$_n" 2>/dev/null || true; done
    docker network rm "$NET" >/dev/null 2>&1 || note "couldn't remove $NET (still in use) — try: hive down && hive up"
  fi
  compose up -d --build
  # shellcheck disable=SC2086
  for _n in $reconnect; do
    [ "$_n" = "${PREFIX}root" ] && continue
    docker network connect "$NET" "$_n" 2>/dev/null || true
  done
  # recreating root loses its injected ssh key (container fs); restore it
  if [ -f "$HOME/.ssh/hive_ed25519.pub" ]; then
    inject_ssh_key "${PREFIX}root" 2>/dev/null || true
  fi
  echo
  echo "hive is up.  next steps:"
  echo "  hive sh root          # shell in the control plane"
  echo "  hive claude root      # claude in the control plane (own login; creds are per-node)"
  echo "  hive new <name>       # spawn a node"
  echo "  hive doctor           # verify the engine + control plane"
}

cmd_down() {
  local nodes
  nodes=$(docker ps -q --filter label=hive.role=node)
  if [ -n "$nodes" ]; then
    note "stopping nodes"
    # shellcheck disable=SC2086
    docker stop $nodes >/dev/null
  fi
  compose down
}

cmd_status() {
  compose ps
  echo
  docker ps -a --filter label=hive.role=node \
    --format 'table {{.Label "hive.name"}}\t{{.Label "hive.parent"}}\t{{.Status}}'
}

# ---------------- nodes ----------------

# The project CLAUDE.md written into a fresh bound project (committed to its repo).
project_claudemd() {
  local name=$1
  cat <<EOMD
# $name

Conventions for any agent working in this project.

## Responses
Shortest possible. No preamble, no restating the task, no validation/agreement
filler. Result first; expand only if asked.

## Git
- Commit often — small commits after each meaningful change.
- \`origin\` is a private GitHub repo; this container holds a write **deploy key**,
  so \`git push\` works (over SSH).

## Memory
Maintain \`.hive/history.md\` (committed): a bounded \`## Consolidated\` summary +
an append-only \`## Log\` of one-line entries. Append as you work; periodically
fold the log into Consolidated (drop redundancy). Read it first in a new
session — it's the project history, cheap on tokens.

## Tools already installed (do NOT probe for these)
git, gh, docker, node, npm, python3/pip, curl, wget, jq, ripgrep (rg), fd, bat,
psql, mysql, redis-cli, sqlite3, build-essential/make/gcc, nmap, tcpdump, dig,
nc, socat, rsync, htop, tmux, vim, nano. Base image: hive/node.

## Docker
You can build/run containers via the mounted host Docker socket. The engine is
**shared** with other projects, so **namespace everything with \`$name-\`**:
images \`$name-*\`, containers \`$name-*\`, networks/volumes \`$name-*\`.
EOMD
}

# Fresh bound project: local git + project files + first commit (in-container).
# Set up a bound project node — works for a brand-new empty dir OR an existing
# dir/repo. Every step is idempotent: git init only if absent, CLAUDE.md only if
# absent, repo created only if missing, deploy key added only if not present.
setup_project() {
  local name=$1 fresh=$2 c="$PREFIX$1"
  inject_read_token "$c"   # container-level (read-all token); does NOT touch the repo
  if [ "$fresh" != 1 ]; then
    note "'$name' bound to an existing dir — its repo is left ENTIRELY untouched (no git init, no commit, no CLAUDE.md, no GitHub)."
    return 0
  fi
  # only a brand-new empty dir gets scaffolded — and never committed/pushed.
  note "scaffolding new project '$name' (local files only — no commit, no GitHub)…"
  if ! docker exec -u dev "$c" test -f /workspace/CLAUDE.md 2>/dev/null; then
    project_claudemd "$name" | docker exec -i -u dev "$c" sh -c 'cat > /workspace/CLAUDE.md'
  fi
  docker exec -u dev "$c" bash -lc '
    cd /workspace
    [ -d .git ] || git init -q
    mkdir -p .hive
    [ -f .hive/history.md ] || printf "## Consolidated\n\n## Log\n" > .hive/history.md
  '
  echo "  scaffolded. When you want a remote: hive $name repo"
}

# EXPLICIT only (hive <node> repo). Creates a private GitHub repo + write deploy
# key and pushes — but ONLY if the workspace has NO git remote AND no same-named
# repo exists. It NEVER repoints an existing remote, never pushes over an
# existing repo, never commits. Refuses otherwise.
setup_project_github() {
  local name=$1 c="$PREFIX$1" owner repo url pub
  url=$(docker exec -u dev "$c" sh -c 'cd /workspace && git remote get-url origin 2>/dev/null' || true)
  if [ -n "$url" ]; then
    note "refusing: $name already has a git remote ($url). hive won't repoint or push to existing remotes."
    return 0
  fi
  owner=$(docker exec "${PREFIX}root" gh api user -q .login 2>/dev/null || true)
  if [ -z "$owner" ]; then note "no gh login — run: hive github login"; return 0; fi
  repo="$owner/$name"
  if docker exec "${PREFIX}root" gh repo view "$repo" >/dev/null 2>&1; then
    note "refusing: $repo already exists on GitHub. Won't push to it — set the remote yourself if that's intended."
    return 0
  fi
  if ! docker exec "${PREFIX}root" gh repo create "$repo" --private >/dev/null 2>&1; then
    note "could not create repo $repo"; return 0
  fi
  echo "  created private repo $repo"
  docker exec -u dev "$c" bash -c 'test -f ~/.ssh/hive_deploy || { mkdir -p ~/.ssh && chmod 700 ~/.ssh && ssh-keygen -q -t ed25519 -N "" -C "$0-deploy" -f ~/.ssh/hive_deploy; }' "$name"
  pub=$(docker exec -u dev "$c" cat /home/dev/.ssh/hive_deploy.pub 2>/dev/null)
  if [ -n "$pub" ]; then
    docker exec "${PREFIX}root" gh api "repos/$repo/keys" -f "title=hive-$name" -F read_only=false -f "key=$pub" >/dev/null 2>&1 \
      && echo "  added write deploy key" || note "deploy key not added"
  fi
  docker exec -u dev "$c" bash -s "$repo" <<'EOSH'
repo=$1
grep -q '^Host github.com' ~/.ssh/config 2>/dev/null || printf 'Host github.com\n  IdentityFile ~/.ssh/hive_deploy\n  IdentitiesOnly yes\n  StrictHostKeyChecking accept-new\n' >> ~/.ssh/config
chmod 600 ~/.ssh/config 2>/dev/null || true
cd /workspace
git remote add origin "git@github.com:$repo.git"
git branch -M main 2>/dev/null || true
git push -u origin main >/dev/null 2>&1 && echo "  pushed to git@github.com:$repo.git" || true
EOSH
}

cmd_new() {
  if [ $# -lt 1 ]; then die "usage: hive new <name> [--parent p] [--bind dir] [--image img] [--dind|--docker] [-- docker args]"; fi
  local name=$1; shift
  if ! [[ "$name" =~ ^[a-z0-9][a-z0-9_-]*$ ]]; then
    die "name must be lowercase alphanumeric plus '-' or '_'"
  fi

  local parent=root bind="" image=$NODE_IMAGE host=0 dind=0 dockmount=0 image_set=0
  local extra=()
  while [ $# -gt 0 ]; do
    case $1 in
      --parent) parent=$2; shift 2 ;;
      --bind)   bind=$2;   shift 2 ;;
      --image)  image=$2; image_set=1; shift 2 ;;
      --host)   host=1;    shift ;;
      --dind)   dind=1;    shift ;;
      --docker) dockmount=1; shift ;;
      --) shift; extra=("$@"); break ;;
      *) die "unknown option '$1' (use -- to pass raw docker run args)" ;;
    esac
  done
  if [ "$dind" = 1 ] && [ "$dockmount" = 1 ]; then
    die "--dind and --docker are mutually exclusive (both bind /var/run/docker.sock)"
  fi
  # dind needs the engine; --docker needs the client. Both ship in the dev image,
  # so default to it unless an explicit --image was given.
  if [ "$dind" = 1 ] || [ "$dockmount" = 1 ]; then
    [ "$image_set" = 0 ] && image=$DEV_IMAGE
    if ! docker image inspect "$image" >/dev/null 2>&1; then
      note "building $image (provides the docker client/engine)…"
      docker build -f "$HIVE_HOME/images/dev/Dockerfile" -t "$DEV_IMAGE" "$HIVE_HOME" >/dev/null
    fi
  fi

  if docker container inspect "$PREFIX$name" >/dev/null 2>&1; then
    die "node '$name' already exists"
  fi
  if ! docker container inspect "$PREFIX$parent" >/dev/null 2>&1; then
    note "warning: parent '$parent' has no container yet — tree will show '$name' as detached"
  fi

  local args=(-d --init --name "$PREFIX$name" --hostname "$name" --network "$NET"
    --add-host host.docker.internal:host-gateway
    --restart unless-stopped
    --label hive.role=node --label "hive.name=$name" --label "hive.parent=$parent"
    -e "HIVE_NAME=$name" -e "HIVE_PARENT=$parent"
    -v hive-shared:/shared -v "hive-claude-$name:/home/dev/.claude")

  # --dind: --privileged is creation-time; a dedicated volume for /var/lib/docker
  # gives the nested engine a real (ext4) fs so overlay2 works (no overlay-on-overlay)
  if [ "$dind" = 1 ]; then
    args+=(--privileged -e HIVE_DIND=1 -v "hive-dind-$name:/var/lib/docker")
  fi
  # VM-isolated runtime (e.g. kata) when configured and registered in the engine
  if [ -n "$NODE_RUNTIME" ]; then args+=(--runtime "$NODE_RUNTIME"); fi

  # --bind => project node, new OR existing dir: one flow, steps are idempotent
  # (git init only if needed, create-repo only if missing, CLAUDE.md only if
  # absent). Recreate (HIVE_RECREATE=1) reuses --bind but must NOT re-onboard.
  local project=0 fresh=0
  if [ -n "$bind" ]; then
    # accept ~, relative, and absolute; resolve to an absolute path
    case $bind in
      '~')   bind="$HOME" ;;
      '~/'*) bind="$HOME/${bind#'~/'}" ;;
      /*)    ;;
      *)     bind="$PWD/$bind" ;;
    esac
    # fresh = brand-new empty dir (the only thing we'll scaffold). Existing dirs
    # are left untouched.
    if [ ! -e "$bind" ] || [ -z "$(ls -A "$bind" 2>/dev/null)" ]; then fresh=1; fi
    [ -e "$bind" ] || mkdir -p "$bind"
    [ "${HIVE_RECREATE:-}" = 1 ] || project=1
    args+=(-v "$bind:/workspace")
  else
    args+=(-v "hive-ws-$name:/workspace")
  fi

  # host Docker access: project nodes (--bind) get it automatically; --docker
  # requests it explicitly so the node drives the host engine, not a nested one.
  if [ "$project" = 1 ] || [ "$dockmount" = 1 ]; then
    args+=(-v /var/run/docker.sock:/var/run/docker.sock)
  fi

  docker run "${args[@]}" "${extra[@]}" "$image" >/dev/null
  if [ -f "$HOME/.ssh/hive_ed25519.pub" ]; then
    inject_ssh_key "$PREFIX$name" || note "warning: could not install ssh key in $name"
  fi
  # --host is sugar: create, then turn the live host switch on
  if [ "$host" = 1 ]; then cmd_node_host "$name" on; fi
  # project node: scaffold/adopt git + GitHub (nodes have internet by default)
  if [ "$project" = 1 ]; then
    setup_project "$name" "$fresh"
  fi
  echo "node '$name' up (parent: $parent)."
  if [ "$dind" = 1 ]; then echo "  (nested dockerd starting — 'docker ps' inside works in a few seconds)"; fi
  echo "  hive sh $name            # shell"
  echo "  hive claude $name        # claude"
  echo "  hive $name github on     # give it your github token"
}

cmd_ls() {
  docker ps -a --filter label=hive.role \
    --format 'table {{.Label "hive.name"}}\t{{.Label "hive.role"}}\t{{.Label "hive.parent"}}\t{{.Status}}\t{{.Names}}'
  local guests
  guests=$(docker network inspect "$NET" \
    --format '{{range .Containers}}{{.Name}}{{"\n"}}{{end}}' 2>/dev/null \
    | grep -v "^$PREFIX" || true)
  if [ -n "$guests" ]; then
    echo
    echo "guests on $NET (joined, no hive labels):"
    echo "$guests" | sed 's/^/  /'
  fi
}

cmd_tree() {
  local rows
  rows=$(docker ps -a --filter label=hive.role=node \
    --format '{{.Label "hive.name"}}|{{.Label "hive.parent"}}|{{.State}}')
  PRINTED=""

  print_children() {
    local parent=$1 indent=$2 name p state
    while IFS='|' read -r name p state; do
      if [ -z "$name" ] || [ "$p" != "$parent" ]; then continue; fi
      echo "${indent}├─ $name [$state]"
      PRINTED="$PRINTED $name"
      print_children "$name" "${indent}│  "
    done <<<"$rows"
  }

  local rootstate
  rootstate=$(docker inspect -f '{{.State.Status}}' "${PREFIX}root" 2>/dev/null || echo absent)
  echo "root [$rootstate]"
  print_children root ""

  local name p state orphans=""
  while IFS='|' read -r name p state; do
    if [ -z "$name" ]; then continue; fi
    case " $PRINTED " in *" $name "*) continue ;; esac
    orphans="$orphans$name (parent: $p) [$state]\n"
  done <<<"$rows"
  if [ -n "$orphans" ]; then
    echo "detached:"
    printf '%b' "$orphans" | sed 's/^/  /'
  fi
}

cmd_sh() {
  local name=root
  if [ $# -gt 0 ]; then name=$1; shift; fi
  if [ $# -gt 0 ]; then
    docker exec "$(tty_flags)" -u dev -w /workspace "$PREFIX$name" zsh -lc "$*"
  else
    docker exec "$(tty_flags)" -u dev -w /workspace "$PREFIX$name" zsh -l
  fi
}

cmd_claude() {
  if [ $# -lt 1 ]; then die "usage: hive claude <node> [claude args...]"; fi
  local name=$1; shift
  docker exec "$(tty_flags)" -u dev -w /workspace "$PREFIX$name" claude "$@"
}

# ---------------- per-node switches ----------------

cmd_node_github() {
  local node=$1 action=${2:-status} c="$PREFIX$1"
  docker container inspect "$c" >/dev/null 2>&1 || die "no such node: $node"
  case $action in
    on)
      ensure_github_token
      if inject_github "$c"; then echo "github: ON for $node"; fi ;;
    off)
      docker exec -u dev "$c" bash -c 'rm -f ~/.git-credentials; git config --global --unset credential.helper 2>/dev/null; gh auth logout >/dev/null 2>&1; true'
      echo "github: OFF for $node (credentials removed)" ;;
    status)
      if docker exec -u dev "$c" test -f /home/dev/.git-credentials 2>/dev/null; then
        echo "github: ON  ($node has credentials)"
      else echo "github: OFF ($node)"; fi ;;
    *) die "usage: hive $node github on|off|status" ;;
  esac
}

# host on/off is a LIVE toggle: the capability is a secret token injected into
# (or removed from) the running node via docker exec — no recreate, like
# github. `hive new --host` is just sugar for this.
cmd_node_host() {
  local node=$1 action=${2:-status} c="$PREFIX$1"
  docker container inspect "$c" >/dev/null 2>&1 || die "no such node: $node"
  case $action in
    on)
      [ -f "$HOSTD_TOKEN_FILE" ] || die "no host daemon yet — run: hive hostd start"
      docker exec -i -u dev "$c" sh -c 'mkdir -p ~/.config/hive && umask 077 && cat > ~/.config/hive/hostd-token' < "$HOSTD_TOKEN_FILE"
      echo "host: ON for $node — it can now run Mac commands with: host <cmd>"
      curl -fsS -m 3 "http://127.0.0.1:$HOSTD_MAC_PORT/health" >/dev/null 2>&1 \
        || note "the Mac daemon isn't up yet — run: hive hostd start" ;;
    off)
      docker exec -u dev "$c" rm -f /home/dev/.config/hive/hostd-token 2>/dev/null || true
      echo "host: OFF for $node (token removed)" ;;
    status)
      if docker exec -u dev "$c" test -f /home/dev/.config/hive/hostd-token 2>/dev/null; then
        echo "host:   ON  ($node can run commands on the Mac)"
      else echo "host:   OFF ($node)"; fi ;;
    *) die "usage: hive $node host on|off|status" ;;
  esac
}

# dind / host-docker are creation-time mounts, so toggling either transparently
# recreates the node, preserving workspace, parent, image, and github/host state
# (the container fs is rebuilt from the image).
# $1=node  $2=want_dind  $3=want_dock   ('' = keep current). dind and the host
# socket are mutually exclusive — both bind /var/run/docker.sock, so dind wins.
# HIVE_RECREATE stops cmd_new re-onboarding.
recreate_node() {
  local node=$1 want_dind=${2:-} want_dock=${3:-} c="$PREFIX$1" parent bind image githubon=0 hoston=0 cur_dind=0 cur_dock=0
  parent=$(docker inspect -f '{{index .Config.Labels "hive.parent"}}' "$c")
  bind=$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/workspace"}}{{if eq .Type "bind"}}{{.Source}}{{end}}{{end}}{{end}}' "$c")
  image=$(docker inspect -f '{{.Config.Image}}' "$c")
  if docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$c" | grep -qx 'HIVE_DIND=1'; then cur_dind=1; fi
  if docker inspect -f '{{range .Mounts}}{{if eq .Destination "/var/run/docker.sock"}}1{{end}}{{end}}' "$c" | grep -q 1; then cur_dock=1; fi
  [ -z "$want_dind" ] && want_dind=$cur_dind
  [ -z "$want_dock" ] && want_dock=$cur_dock
  [ "$want_dind" = 1 ] && want_dock=0   # dind owns /var/run/docker.sock
  if docker exec -u dev "$c" test -f /home/dev/.git-credentials 2>/dev/null; then githubon=1; fi
  if docker exec -u dev "$c" test -f /home/dev/.config/hive/hostd-token 2>/dev/null; then hoston=1; fi
  docker rm -f "$c" >/dev/null
  local nargs=(--parent "$parent")
  if [ -n "$bind" ]; then nargs+=(--bind "$bind"); fi
  # preserve a custom image; the default node/dev images track --dind/--docker
  if [ -n "$image" ] && [ "$image" != "$NODE_IMAGE" ] && [ "$image" != "$DEV_IMAGE" ]; then
    nargs+=(--image "$image")
  fi
  if [ "$want_dind" = 1 ]; then nargs+=(--dind); fi
  if [ "$want_dock" = 1 ]; then nargs+=(--docker); fi
  # NOTE: raw `-- <docker run args>` from the original `hive new` are not replayed
  # here (they can't be recovered from `docker inspect`).
  HIVE_RECREATE=1; cmd_new "$node" "${nargs[@]}" >/dev/null; unset HIVE_RECREATE
  if [ "$githubon" = 1 ]; then cmd_node_github "$node" on >/dev/null; fi
  if [ "$hoston" = 1 ]; then cmd_node_host "$node" on >/dev/null; fi
}

cmd_node_recreate() {
  local node=$1 c="$PREFIX$1"
  docker container inspect "$c" >/dev/null 2>&1 || die "no such node: $node"
  note "recreating $node from the current image (workspace + volumes + dind/docker/github/host preserved)…"
  recreate_node "$node"
  echo "recreated $node"
}

cmd_node_dind() {
  local node=$1 action=${2:-status} c="$PREFIX$1"
  docker container inspect "$c" >/dev/null 2>&1 || die "no such node: $node"
  case $action in
    status)
      if docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$c" | grep -qx 'HIVE_DIND=1'; then
        echo "dind:   ON  ($node has a nested docker engine)"
      else echo "dind:   OFF ($node)"; fi ;;
    on|off)
      local want=0; if [ "$action" = on ]; then want=1; fi
      note "recreating $node to turn dind $action (workspace + state preserved)…"
      recreate_node "$node" "$want"
      echo "dind: $action for $node (recreated; workspace, github, host preserved)" ;;
    *) die "usage: hive $node dind on|off|status" ;;
  esac
}

# docker on/off mounts (or removes) the host Docker socket so the node drives the
# host's engine instead of a nested one. Creation-time, so it recreates the node;
# turning it on turns dind off (they can't share /var/run/docker.sock).
cmd_node_docker() {
  local node=$1 action=${2:-status} c="$PREFIX$1"
  docker container inspect "$c" >/dev/null 2>&1 || die "no such node: $node"
  case $action in
    status)
      if docker inspect -f '{{range .Mounts}}{{if eq .Destination "/var/run/docker.sock"}}1{{end}}{{end}}' "$c" | grep -q 1; then
        echo "docker: ON  ($node mounts the host Docker socket)"
      else echo "docker: OFF ($node)"; fi ;;
    on)
      note "recreating $node with the host Docker socket (dind off; workspace + state preserved)…"
      recreate_node "$node" 0 1
      echo "docker: ON for $node (recreated; uses the host engine)" ;;
    off)
      note "recreating $node without the host Docker socket (workspace + state preserved)…"
      recreate_node "$node" "" 0
      echo "docker: OFF for $node (recreated)" ;;
    *) die "usage: hive $node docker on|off|status" ;;
  esac
}

cmd_node_status() {
  local node=$1 c="$PREFIX$1"
  docker container inspect "$c" >/dev/null 2>&1 || die "no such node: $node"
  echo "$node:"
  cmd_node_github "$node" status
  cmd_node_host "$node" status
  cmd_node_dind "$node" status
  cmd_node_docker "$node" status
}

# ---------------- host daemon (Mac side) ----------------

cmd_hostd() {
  local sub=${1:-status}
  local pidf="$HOME/.config/hive/hostd.pid" logf="$HOME/.config/hive/hostd.log"
  local daemon="$HIVE_HOME/bin/hive-hostd"
  case $sub in
    start)
      mkdir -p "$HOME/.config/hive" && chmod 700 "$HOME/.config/hive"
      if [ ! -f "$HOSTD_TOKEN_FILE" ]; then
        ( umask 077; openssl rand -hex 32 > "$HOSTD_TOKEN_FILE" ); echo "generated host token ($HOSTD_TOKEN_FILE)"
      fi
      if curl -fsS -m 3 "http://127.0.0.1:$HOSTD_MAC_PORT/health" >/dev/null 2>&1; then
        echo "hostd already running on Mac:$HOSTD_MAC_PORT"
      else
        HIVE_HOSTD_PORT=$HOSTD_MAC_PORT nohup python3 "$daemon" >>"$logf" 2>&1 &
        echo $! > "$pidf"; sleep 1
        if ! curl -fsS -m 3 "http://127.0.0.1:$HOSTD_MAC_PORT/health" >/dev/null 2>&1; then
          note "hostd failed to bind Mac:$HOSTD_MAC_PORT (in use?). Set a free port: HIVE_HOSTD_MAC_PORT=NNNN hive hostd start"
          tail -n 3 "$logf" 2>/dev/null | sed 's/^/  /'
          return 1
        fi
        echo "hostd running on Mac:$HOSTD_MAC_PORT (pid $(cat "$pidf")) — logs: hive hostd logs"
      fi
      echo "nodes reach it directly at host.docker.internal:$HOSTD_MAC_PORT"
      echo "now bless nodes:  hive <node> host on"
      ;;
    stop)
      if [ -f "$pidf" ]; then kill "$(cat "$pidf")" 2>/dev/null || true; rm -f "$pidf"; fi
      pkill -f "$daemon" 2>/dev/null || true
      echo "hostd stopped"
      ;;
    status)
      if curl -fsS -m 3 "http://127.0.0.1:$HOSTD_MAC_PORT/health" >/dev/null 2>&1; then
        echo "hostd: running (Mac:$HOSTD_MAC_PORT)"
      else echo "hostd: stopped"; fi
      ;;
    logs)
      tail -n "${2:-40}" "$logf" 2>/dev/null || echo "(no log yet)" ;;
    *) die "usage: hive hostd start|stop|status|logs" ;;
  esac
}

cmd_rm() {
  local purge=0 names=() a
  for a in "$@"; do
    case $a in
      --purge) purge=1 ;;
      *) names+=("$a") ;;
    esac
  done
  if [ ${#names[@]} -lt 1 ]; then die "usage: hive rm <name>... [--purge]"; fi
  local n
  for n in "${names[@]}"; do
    if [ "$n" = root ]; then die "root is managed by 'hive up/down'"; fi
    docker rm -f "$PREFIX$n" >/dev/null
    echo "removed $n"
    if [ "$purge" = 1 ]; then
      # NEVER delete the workspace volume — that's the user's data.
      if docker volume rm "hive-dind-$n" >/dev/null 2>&1; then
        echo "purged volume hive-dind-$n"
      fi
      if docker volume rm "hive-claude-$n" >/dev/null 2>&1; then
        echo "purged volume hive-claude-$n"
      fi
      if docker volume inspect "hive-ws-$n" >/dev/null 2>&1; then
        echo "kept workspace volume hive-ws-$n (remove manually if you truly want it gone)"
      fi
    fi
  done
}

cmd_join() {
  if [ $# -lt 1 ]; then die "usage: hive join <container>"; fi
  local target=$1
  docker network connect "$NET" "$target"
  echo "joined '$target' to $NET (shows under guests in 'hive ls')"
}

# ---------------- ssh (desktop app / IDE access) ----------------

inject_ssh_key() {
  local container=$1
  docker exec -i "$container" bash -c \
    'mkdir -p /home/dev/.ssh && cat > /home/dev/.ssh/authorized_keys \
     && chown -R dev:dev /home/dev/.ssh && chmod 700 /home/dev/.ssh \
     && chmod 600 /home/dev/.ssh/authorized_keys' \
    < "$HOME/.ssh/hive_ed25519.pub"
}

cmd_ssh() {
  local sub=${1:-}
  if [ "$sub" != setup ]; then
    if [ -z "$sub" ]; then die "usage: hive ssh setup | hive ssh <node>"; fi
    shift
    exec ssh "$PREFIX$sub" "$@"
  fi

  # 1. dedicated key
  if [ ! -f "$HOME/.ssh/hive_ed25519" ]; then
    ssh-keygen -t ed25519 -N "" -C "hive-desktop" -f "$HOME/.ssh/hive_ed25519" >/dev/null
    echo "generated ~/.ssh/hive_ed25519"
  fi

  # 2. managed block in ~/.ssh/config — SSH rides `docker exec` on stdio, so
  #    nodes never open a port; only this Mac (docker socket) can connect.
  local cfg="$HOME/.ssh/config" docker_bin ctx
  docker_bin=$(command -v docker)
  ctx=$(docker context show)
  mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh"
  touch "$cfg" && chmod 600 "$cfg"
  awk '/^# >>> hive managed >>>/{skip=1} !skip{print} /^# <<< hive managed <<</{skip=0}' \
    "$cfg" > "$cfg.tmp"
  cat >> "$cfg.tmp" <<EOF
# >>> hive managed >>>
# Regenerate with: hive ssh setup
Host ${PREFIX}*
  User dev
  IdentityFile ~/.ssh/hive_ed25519
  ProxyCommand $docker_bin --context $ctx exec -i %n /usr/sbin/sshd -i -f /etc/ssh/sshd_config.hive
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  LogLevel ERROR
  ServerAliveInterval 20
  ServerAliveCountMax 6
  TCPKeepAlive yes
# <<< hive managed <<<
EOF
  mv "$cfg.tmp" "$cfg" && chmod 600 "$cfg"
  echo "updated ~/.ssh/config (managed block: Host ${PREFIX}*)"

  # 3. install the key in every running hive container
  local c installed=0
  while read -r c; do
    if [ -z "$c" ]; then continue; fi
    if inject_ssh_key "$c" 2>/dev/null; then
      installed=$((installed + 1))
      echo "  key installed in $c"
    fi
  done < <(docker ps --filter label=hive.role --format '{{.Names}}')
  if [ "$installed" = 0 ]; then
    note "no running nodes yet — keys are installed automatically by 'hive new'"
  fi

  cat <<EOF

desktop app: Code tab -> environment dropdown -> '+ Add SSH connection'
  Name:     any label (e.g. the node name)
  SSH Host: ${PREFIX}<node>        (e.g. ${PREFIX}root)
  Port / Identity file: leave empty (~/.ssh/config handles it)
EOF
}

# ---------------- private github ----------------

GH_TOKEN_FILE="$HOME/.config/hive/github-token"
GH_APP_DIR="$HOME/.config/hive/github-app"

_b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }

# Mint a ~1h GitHub App installation token (read-all). Echoes the token, or
# nothing if the App isn't configured. Runs on the Mac — the App private key
# never leaves the Mac; only the short-lived token is handed to a container.
github_app_token() {
  local app inst pem now header payload sig jwt
  app=$(cat "$GH_APP_DIR/app-id" 2>/dev/null)
  inst=$(cat "$GH_APP_DIR/installation-id" 2>/dev/null)
  pem="$GH_APP_DIR/app.pem"
  [ -n "$app" ] && [ -n "$inst" ] && [ -f "$pem" ] || return 1
  command -v openssl >/dev/null 2>&1 || return 1
  now=$(date +%s)
  header=$(printf '{"alg":"RS256","typ":"JWT"}' | _b64url)
  payload=$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' $((now-60)) $((now+540)) "$app" | _b64url)
  sig=$(printf '%s.%s' "$header" "$payload" | openssl dgst -sha256 -sign "$pem" -binary | _b64url)
  jwt="$header.$payload.$sig"
  curl -s -X POST -H "Authorization: Bearer $jwt" -H "Accept: application/vnd.github+json" \
    "https://api.github.com/app/installations/$inst/access_tokens" \
    | python3 -c 'import sys,json; print(json.load(sys.stdin).get("token",""))' 2>/dev/null
}

# Install a fresh read-all token as the HTTPS git credential in a container (for
# reading ANY of your repos). Origin uses the SSH deploy key, so this doesn't
# touch the project's own push path. Token is short-lived — re-run to refresh.
inject_read_token() {
  local c=$1 tok
  tok=$(github_app_token) || true
  if [ -z "$tok" ]; then
    note "read-all token skipped (GitHub App not configured at $GH_APP_DIR or unreachable)"
    return 0
  fi
  printf '%s' "$tok" | docker exec -i -u dev "$c" bash -c '
    tok=$(cat); umask 077; f="$HOME/.git-credentials"
    [ -f "$f" ] && grep -v "x-access-token:.*@github.com" "$f" > "$f.tmp" 2>/dev/null || : > "$f.tmp"
    printf "https://x-access-token:%s@github.com\n" "$tok" >> "$f.tmp"
    mv "$f.tmp" "$f"
    git config --global credential.helper store
  '
  # remember this node + keep its token fresh forever (App tokens expire in ~1h)
  local nm=${c#$PREFIX}
  mkdir -p "$(dirname "$READ_NODES_FILE")"; touch "$READ_NODES_FILE"
  grep -qxF "$nm" "$READ_NODES_FILE" 2>/dev/null || printf '%s\n' "$nm" >> "$READ_NODES_FILE"
  ensure_token_daemon
  echo "  read-all token injected (auto-refreshed; read-only)"
}

READ_NODES_FILE="$HOME/.config/hive/read-nodes"
TOKEN_DAEMON_PID="$HOME/.config/hive/token-daemon.pid"

ensure_token_daemon() {
  [ -f "$TOKEN_DAEMON_PID" ] && kill -0 "$(cat "$TOKEN_DAEMON_PID")" 2>/dev/null && return 0
  cmd_token start >/dev/null 2>&1 || true
}

# Effectively-unlimited read-all: a background loop re-mints + re-injects every
# 45 min (GitHub caps each token at ~1h). Auto-starts on first read-token use.
cmd_token() {
  local sub=${1:-status}
  case $sub in
    refresh)
      [ -f "$READ_NODES_FILE" ] || return 0
      while read -r n; do
        [ -n "$n" ] || continue
        docker container inspect "$PREFIX$n" >/dev/null 2>&1 && inject_read_token "$PREFIX$n" >/dev/null 2>&1 || true
      done < "$READ_NODES_FILE" ;;
    start)
      mkdir -p "$(dirname "$TOKEN_DAEMON_PID")"
      if [ -f "$TOKEN_DAEMON_PID" ] && kill -0 "$(cat "$TOKEN_DAEMON_PID")" 2>/dev/null; then
        echo "token refresher already running"; return 0; fi
      nohup bash -c 'while true; do sleep 2700; "$0" token refresh >/dev/null 2>&1; done' "$HIVE_SELF" >/dev/null 2>&1 &
      echo $! > "$TOKEN_DAEMON_PID"
      echo "token refresher started (re-mints read-all tokens every 45m)" ;;
    stop)
      [ -f "$TOKEN_DAEMON_PID" ] && kill "$(cat "$TOKEN_DAEMON_PID")" 2>/dev/null || true
      rm -f "$TOKEN_DAEMON_PID"; echo "token refresher stopped" ;;
    status)
      if [ -f "$TOKEN_DAEMON_PID" ] && kill -0 "$(cat "$TOKEN_DAEMON_PID")" 2>/dev/null; then
        echo "token refresher: running (pid $(cat "$TOKEN_DAEMON_PID"))  nodes: $([ -f "$READ_NODES_FILE" ] && tr '\n' ' ' < "$READ_NODES_FILE")"
      else echo "token refresher: stopped"; fi ;;
    *) die "usage: hive token start|stop|status" ;;
  esac
}

# Install a token into one container: git credential helper (HTTPS) + gh CLI.
# Token arrives on stdin, never via argv/env/image layers.
inject_github() {
  docker exec -u dev -i "$1" bash -c '
    set -e
    tok=$(cat)
    [ -n "$tok" ] || exit 0
    umask 077
    printf "https://x-access-token:%s@github.com\n" "$tok" > "$HOME/.git-credentials"
    git config --global credential.helper store
    if command -v gh >/dev/null 2>&1; then
      printf "%s" "$tok" | gh auth login --with-token >/dev/null 2>&1 \
        && echo "    gh: authenticated" \
        || echo "    gh: token not validated (git https still works)"
    fi
  ' < "$GH_TOKEN_FILE"
}

store_github_token() {
  mkdir -p "$(dirname "$GH_TOKEN_FILE")" && chmod 700 "$(dirname "$GH_TOKEN_FILE")"
  ( umask 077; printf '%s' "$1" > "$GH_TOKEN_FILE" )
}

# Obtain a token for the user via GitHub's device login (run with root's gh).
# One browser approval; the token is cached hive-wide so this never runs again.
github_login() {
  local runner="${PREFIX}root" token
  docker container inspect "$runner" >/dev/null 2>&1 || die "root must be running first (hive up)"
  token=$(docker exec "$runner" gh auth token 2>/dev/null || true)
  if [ -z "$token" ]; then
    note "GitHub login (one-time): open the URL shown below, enter the code, approve."
    docker exec -i "$runner" gh auth login --hostname github.com --git-protocol https --web </dev/null \
      || die "github login was cancelled"
    token=$(docker exec "$runner" gh auth token 2>/dev/null || true)
  fi
  [ -n "$token" ] || die "login finished but gh returned no token"
  store_github_token "$token"
  echo "cached your GitHub token in $GH_TOKEN_FILE — future 'github on' is silent" >&2
}

# Ensure a token is cached. No paste prompt: a token piped on stdin is accepted
# (automation), otherwise hive logs you in for itself.
ensure_github_token() {
  [ -f "$GH_TOKEN_FILE" ] && return 0
  if [ ! -t 0 ]; then
    local t=""; IFS= read -r t || true
    if [ -n "$t" ]; then store_github_token "$t"; return 0; fi
  fi
  github_login
}

# Manage the cached token; per-node on/off does the injecting.
cmd_github() {
  local sub=${1:-}
  case $sub in
    login)
      github_login ;;
    --forget|forget)
      rm -f "$GH_TOKEN_FILE" && echo "removed the cached token ($GH_TOKEN_FILE)"
      echo "remove it from a node with: hive <node> github off" ;;
    "")
      if [ -f "$GH_TOKEN_FILE" ]; then echo "github token: cached ($GH_TOKEN_FILE)"
      else echo "github token: none — 'hive <node> github on' logs you in once and caches it"; fi ;;
    *)
      store_github_token "$sub"
      echo "stored the token you provided ($GH_TOKEN_FILE). enable it: hive <node> github on" ;;
  esac
}

# ---------------- doctor ----------------

check() {
  local label=$1; shift
  if "$@" >/dev/null 2>&1; then
    echo "  ok   $label"
  else
    echo "  FAIL $label"
    DOCTOR_FAIL=1
  fi
}

cmd_doctor() {
  DOCTOR_FAIL=0
  echo "  engine: ${DOCKER_CONTEXT:-$(docker context show 2>/dev/null || echo default)}"
  echo "  node runtime: ${NODE_RUNTIME:-engine default (runc)}  |  available: $(docker info --format '{{range $k,$v := .Runtimes}}{{$k}} {{end}}' 2>/dev/null)"
  check "docker daemon reachable"        docker info
  check "root container running"         docker exec "${PREFIX}root" true
  check "root can drive docker (socket)" docker exec "${PREFIX}root" docker ps
  check "root has internet"              docker exec "${PREFIX}root" curl -sS -o /dev/null -m 20 https://api.anthropic.com
  if [ "$(docker network inspect "$NET" -f '{{.Internal}}' 2>/dev/null)" = true ]; then
    echo "  FAIL $NET is 'internal' — nodes have no internet; run 'hive up' to recreate it"
    DOCTOR_FAIL=1
  else
    echo "  ok   $NET is not internal (nodes get internet)"
  fi
  if [ "$DOCTOR_FAIL" != 0 ]; then
    exit 1
  fi
}

# ---------------- devcontainer ----------------

cmd_devcontainer() {
  if [ $# -lt 1 ]; then die "usage: hive devcontainer <project-dir>"; fi
  local dir=$1 dest
  if [ ! -d "$dir" ]; then die "no such directory: $dir"; fi
  dest="$dir/.devcontainer"
  if [ -e "$dest/devcontainer.json" ]; then
    die "$dest/devcontainer.json already exists — remove it first"
  fi
  mkdir -p "$dest"
  cp "$HIVE_HOME/templates/devcontainer/devcontainer.json" "$dest/"
  echo "wrote $dest/devcontainer.json"
  echo "open the folder in VS Code/Cursor -> 'Reopen in Container' (needs 'hive up' first)"
}

# ---------------- main ----------------

cmd=help
if [ $# -gt 0 ]; then cmd=$1; shift; fi

case $cmd in
  build)         cmd_build "$@" ;;
  up)            cmd_up "$@" ;;
  down)          cmd_down "$@" ;;
  status)        cmd_status "$@" ;;
  doctor)        cmd_doctor "$@" ;;
  new)           cmd_new "$@" ;;
  ls)            cmd_ls "$@" ;;
  tree)          cmd_tree "$@" ;;
  sh)            cmd_sh "$@" ;;
  claude)        cmd_claude "$@" ;;
  rm)            cmd_rm "$@" ;;
  join)          cmd_join "$@" ;;
  ssh)           cmd_ssh "$@" ;;
  github)        cmd_github "$@" ;;
  token)         cmd_token "$@" ;;
  hostd)         cmd_hostd "$@" ;;
  devcontainer)  cmd_devcontainer "$@" ;;
  help|-h|--help) usage ;;
  *)
    # per-node form: hive <node> <verb> [...]
    if docker container inspect "$PREFIX$cmd" >/dev/null 2>&1; then
      verb=${1:-status}; shift || true
      case $verb in
        github)     cmd_node_github "$cmd" "$@" ;;
        host)       cmd_node_host   "$cmd" "$@" ;;
        dind)       cmd_node_dind   "$cmd" "$@" ;;
        docker)     cmd_node_docker "$cmd" "$@" ;;
        repo)       docker container inspect "$PREFIX$cmd" >/dev/null 2>&1 || die "no such node: $cmd"
                    setup_project_github "$cmd" "$PREFIX$cmd" ;;
        token)      docker container inspect "$PREFIX$cmd" >/dev/null 2>&1 || die "no such node: $cmd"
                    inject_read_token "$PREFIX$cmd" ;;
        recreate)   cmd_node_recreate "$cmd" ;;
        sh)         cmd_sh          "$cmd" "$@" ;;
        claude)     cmd_claude      "$cmd" "$@" ;;
        status)     cmd_node_status "$cmd" ;;
        *) die "unknown verb '$verb' for node '$cmd' (github|host|dind|docker|repo|token|recreate|sh|claude|status)" ;;
      esac
    else
      echo "hive: unknown command or node: $cmd" >&2
      usage; exit 1
    fi
    ;;
esac
